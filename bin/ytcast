#!/usr/bin/env bash
# ytcast – YouTube Music on Chromecast speakers (made for a Harman Kardon Citation): your liked songs, playlists and
# search in fzf with vim keys, "now playing" in the footer. Unofficial; not affiliated with Google or YouTube.
#
# Playback runs in ytcast-player, a small daemon per speaker that keeps the Cast connection and the queue; this
# script talks to it with curl over a unix socket. The UI calls itself (_show/_enter/_key/_label/_now/_ticker) from
# fzf key bindings and the ticker loop. Lists are fetched with yt-dlp the first time a tab is shown.
# Rows (fields separated by TAB):
#   songs (liked, pl, search):  Title ‒ Artist <TAB> YouTube URL   (shown with ▶ on the one playing)
#   playlists, albums:          Name (‒ Artist) <TAB> playlist / album URL
#   queue (from the player):    played|playing|queued <TAB> Title ‒ Artist <TAB> YouTube URL
#   speakers (stored):          IP Name
set -euo pipefail
(( BASH_VERSINFO[0] >= 5 )) || { echo "ytcast needs bash >= 5" >&2; exit 1; }
self=$(readlink -f "${BASH_SOURCE[0]}")
app="ytcast 0.9.1"  # name and version shown at the top of the UI

# Config: host=<speaker IP>, cookies=<browser to read the YouTube login from> (default firefox, empty = no login)
config=${XDG_CONFIG_HOME:-$HOME/.config}/ytcast/config
cache=${XDG_CACHE_HOME:-$HOME/.cache}/ytcast  # liked songs and playlists, kept between runs (r refreshes)
host="" cookies=firefox
# shellcheck source=/dev/null
[[ -f $config ]] && source "$config"
YTCAST_HOST=${YTCAST_HOST:-$host}
save_config() { mkdir -p "${config%/*}"; printf 'host=%s\ncookies=%s\n' "$YTCAST_HOST" "$cookies" >"$config"; }
run=${XDG_RUNTIME_DIR:-/tmp}
keys='j,k,g,G,h,l,t,T,r,a,s,S,d,m,space,n,p,+,-,q,/,?'  # unbound while typing

# --- Speakers ---

info() { curl -s --connect-timeout 1 --max-time 2 "http://$1:8008/setup/eureka_info"; }  # Cast device info (JSON)
name() { local n; n=$(grep -oE '"name":"[^"]*"' <<<"$1" | cut -d'"' -f4); printf '%b' "$n"; }  # ø → ø
local_ip() { ip -4 -o route get 1.1.1.1 | grep -oE 'src [0-9.]+' | cut -d' ' -f2; }

# Cast speakers on the local network ("IP Name"); assumes a /24 network
scan() {
    local net
    net=$(local_ip)
    net=${net%.*}
    for i in {1..254}; do
        (s=$(info "$net.$i") && [[ -n $s ]] && echo "$net.$i $(name "$s")") &
    done
    wait
}

# --- Player daemon (ytcast-player) ---

ctl() { curl -s --fail-with-body --max-time 60 --unix-socket "$run/ytcast-$YTCAST_HOST.sock" "http://ytcast/$1" "${@:2}"; }
player() {  # start ytcast-player for the speaker unless it is running (restart one left from before an update)
    local build running
    build=$(stat -c %Y "${self%/*}/ytcast-player")
    running=$(ctl ping 2>/dev/null) || running=""
    [[ $running == "$build" ]] && return
    if [[ -n $running ]]; then
        echo "Restarting the player (ytcast was updated)…" >&2
        [[ -n ${YT_DIR:-} ]] && busy "Restarting the player (ytcast was updated)…"
        pkill -f "ytcast-player $YTCAST_HOST $run/" || true
        for _ in {1..25}; do ctl ping &>/dev/null || break; sleep 0.2; done
    fi
    info "$YTCAST_HOST" >/dev/null || {
        echo "ytcast: no answer from speaker at $YTCAST_HOST. If its IP changed, run 'ytcast scan' and 'ytcast use <IP>'" >&2
        return 1
    }
    echo "Connecting to $YTCAST_HOST…" >&2
    setsid "${self%/*}/ytcast-player" "$YTCAST_HOST" "$run/ytcast-$YTCAST_HOST.sock" "$cookies" \
        </dev/null &>"$run/ytcast-$YTCAST_HOST.log" &
    for _ in {1..50}; do [[ $(ctl ping 2>/dev/null) == "$build" ]] && return; sleep 0.2; done
    echo "ytcast: the player did not start; see $run/ytcast-$YTCAST_HOST.log" >&2
    return 1
}

# --- YouTube Music (yt-dlp) ---

ytdlp() { yt-dlp --no-warnings ${cookies:+--cookies-from-browser "$cookies"} "$@"; }
urlencode() { python3 -c 'import sys, urllib.parse; print(urllib.parse.quote_plus(sys.argv[1]))' "$1"; }
search_url() { echo "https://music.youtube.com/search?q=$(urlencode "$1")"; }
songs() {  # songs of a playlist or search page $1 as rows; $2 = max number (search pages go on and on)
    ytdlp --flat-playlist --playlist-end "${2:-500}" --print '%(title)s	%(channel,uploader,artist|)s	%(url)s' "$1" |
        awk -F'\t' -v OFS='\t' '$3 ~ /watch\?v=/ { sub(/ - Topic$/, "", $2); print ($2 == "" ? $1 : $1 " ‒ " $2), $3 }'
}
# Albums on a search page $1 as rows. The search gives no names, so each album is looked up (in parallel).
albums() {
    local d u i=0 n
    d=$(mktemp -d)
    while IFS= read -r u; do
        printf -v n '%03d' $((i += 1))
        (ytdlp --flat-playlist --playlist-items 1 --print '%(playlist_title)s	%(playlist_uploader,playlist_channel|)s' "$u" |
            awk -F'\t' -v OFS='\t' -v u="$u" '{ sub(/ - Topic$/, "", $2); print ($2 == "" ? $1 : $1 " ‒ " $2), u }' >"$d/$n") &
    done < <(ytdlp --flat-playlist --playlist-end 12 --print url "$1" | grep '/browse/MPREb_')
    wait
    cat "$d"/* 2>/dev/null || true
    rm -rf "$d"
}
is_list() { [[ $1 == *@(/browse/|list=)* ]]; }  # a playlist or album URL (not a song)
playlists() {
    ytdlp --flat-playlist --print '%(title)s	%(url)s' "https://www.youtube.com/feed/playlists" | grep -E 'list=' || true
}

# --- UI ---

st()  { cat "$YT_DIR/$1" 2>/dev/null || true; }  # read state
put() { echo "$2" >"$YT_DIR/$1"; }
# The chosen speaker is kept in state, so all sub-calls follow along when it changes
[[ -n ${YT_DIR:-} && -s ${YT_DIR:-}/host ]] && read -r YTCAST_HOST <"$YT_DIR/host"

section() { local s; s=$(st section); echo "${s:-songs}"; }  # search section: songs, videos or albums
list() {  # file of a list
    case $1 in
        liked | playlists) echo "$cache/$1" ;;
        search) echo "$YT_DIR/search-$(section)" ;;
        *) echo "$YT_DIR/$1" ;;
    esac
}
fetch() {  # $1 = list
    case $1 in
        liked) songs "https://music.youtube.com/playlist?list=LM" ;;
        playlists) playlists ;;
        pl) songs "$(st plurl)" ;;
        search)
            [[ -n $(st searched) ]] || return 0
            if [[ $(section) == albums ]]; then albums "$(search_url "$(st searched)")#albums"
            else songs "$(search_url "$(st searched)")#$(section)" 30; fi ;;
        speakers) scan | sort -t. -k4,4n ;;
        queue) ctl queue 2>/dev/null || true ;;
    esac
}
clean() { local t=${1#  }; t=${t#▶ } t=${t#⋯ }; echo "${t% -- Fetching…}"; }  # a row's title without ▶ ⋯ markers
swap() { awk -F'\t' '{ print $2 "\t" $1 }'; }  # "Title<TAB>URL" rows → "URL<TAB>Title" lines for the player

# Tab line with the current tab in brackets, e.g. "Liked (gl)  Playlists (gp)  [ Search (gs) › Albums ]  Speakers (gS)"
tabline() {
    local cur=$1 out="" t n sec
    local -A short=([liked]=gl [playlists]=gp [search]=gs [queue]=gq [speakers]=gS)  # shown after the name: "Liked (gl)"
    [[ $cur == menu ]] && cur=$(st mfrom)
    [[ $cur == pl ]] && cur=$(st plfrom)
    for t in liked playlists search queue speakers; do
        n="${t^} (${short[$t]})"
        [[ $t == search && $1 == search ]] && sec=$(section) && n+=" › ${sec^}"
        [[ $t == "$cur" && ($1 == pl || ($1 == menu && $(st mfrom) == pl)) ]] && n+=" › $(st plname)"
        [[ $t == "$cur" && $1 == menu ]] && n+=" › Menu"
        if [[ $t == "$cur" ]]; then out+="[ $n ]  "; else out+="$n  "; fi
    done
    echo "${out%  }"
}
label() { echo "change-border-label: $app │ $(st name) │ $(tabline "$(st tab)")${1:-} "; }

# Show tab $1: fzf actions. Search doesn't filter, and shows the input until there is a search; enter runs it.
view() {
    local search=enable-search input="hide-input+rebind($keys)" prompt=$1
    put tab "$1"
    [[ $1 == pl ]] && prompt=list
    [[ $1 == search ]] && search=disable-search
    [[ $1 == search && -z $(st searched) ]] && input="show-input+unbind($keys)"
    echo "clear-query+$search+$input+reload($self _show $1)+first+change-prompt($prompt> )+$(label)"
}
tab_step() {  # $1 = +1 / -1: the next / previous tab
    local tabs=(liked playlists search queue speakers) cur i
    cur=$(st tab)
    [[ $cur == pl ]] && cur=$(st plfrom)
    for i in "${!tabs[@]}"; do [[ ${tabs[i]} == "$cur" ]] && break; done
    view "${tabs[(i + $1 + 5) % 5]}"
}
open_list() {  # $1 = row ({1}), $2 = playlist / album URL: show its songs; h goes back to where it came from
    local tab
    tab=$(st tab)
    [[ $tab == pl ]] || put plfrom "$tab"
    put plname "${1#  }"; put plurl "$2"; rm -f "$(list pl)"
    view pl
}
queue_add() {  # $1 = row, $2 = URL, $3 = next (right after the song playing): add the song, or all songs of a playlist / album
    local t how=append done=Queued
    t=$(clean "$1")
    [[ ${3:-} == next ]] && how=next done="Playing next"
    {
        busy "Adding \"${t%% ‒ *}\" to the queue…"
        player && if is_list "$2"; then songs "$2" | swap; else printf '%s\t%s\n' "$2" "$t"; fi |
            ctl "queue?$how=1" --data-binary @- && note "$done: ${t%% ‒ *}"
        [[ $(st tab) == queue ]] && fzf_do "reload($self _show queue)"
    } </dev/null &>/dev/null &
}

# --- Status line (the footer label, just above "now playing"): what ytcast is waiting for, with a spinner ---
# Each slow job writes its message to $YT_DIR/busy.<pid>; the ticker shows the newest one while that process lives.
busy() { echo "$1" >"$YT_DIR/busy.$BASHPID"; }
note() { echo "$1" >"$YT_DIR/note"; }  # shown for 4 s with ✓ when nothing is busy
spinner=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
fzf_do() { curl -s --unix-socket "$YT_DIR/fzf.sock" -XPOST http://localhost -d "$1" >/dev/null || true; }  # run fzf actions
status_line() {  # $1 = frame number, $2 = "now playing" from the player
    local f msg="" age=0
    for f in "$YT_DIR"/busy.*; do
        [[ -e $f ]] || continue
        kill -0 "${f##*.}" 2>/dev/null || { rm -f "$f"; continue; }
        msg=$(<"$f") age=$((EPOCHSECONDS - $(stat -c %Y "$f")))
    done
    # Order: our own jobs, then a fresh confirmation (4 s), then the player fetching a stream, else the hint
    if [[ -n $msg ]]; then
        (( age >= 2 )) && msg+=" ${age}s"
        echo " ${spinner[$1 % 10]} $msg "
    elif [[ -s $YT_DIR/note ]] && (( EPOCHSECONDS - $(stat -c %Y "$YT_DIR/note") < 4 )); then
        echo " ✓ $(<"$YT_DIR/note") "
    elif [[ ${2%%$'\n'*} == ⋯* ]]; then
        echo " ${spinner[$1 % 10]} Fetching the audio stream for the next song… "
    else
        [[ $(st tab) == speakers ]] && echo " enter: use this speaker · r: scan again " || echo " Press ? for shortcuts "
    fi
}
what() {  # what fetching list $1 means, for the status line
    case $1 in
        liked) echo "Fetching your liked songs from YouTube Music…" ;;
        playlists) echo "Fetching your playlists…" ;;
        pl) echo "Fetching the songs in \"$(st plname)\"…" ;;
        search) [[ $(section) == albums ]] && echo "Searching albums for \"$(st searched)\" and looking up their names…" ||
            echo "Searching YouTube Music for \"$(st searched)\" ($(section))…" ;;
        speakers) echo "Scanning the network for speakers…" ;;
    esac
}

remove_from_queue() {  # $1 = index, $2 = row; in the background, as removing the song playing starts the next one
    note "Removed: $(clean "$2")"
    { ctl "remove?i=$1"; [[ $(st tab) == queue ]] && fzf_do "reload($self _show queue)"; } </dev/null &>/dev/null &
}

# --- Menu (m): the actions for the row under the cursor, shown in place of the list ---

open_menu() {  # $1 = row, $2 = URL, $3 = index
    [[ -n $2 && $(st tab) != @(speakers|menu) ]] || return 0
    put mfrom "$(st tab)"; put mrow "$(clean "$1")"; put murl "$2"; put mn "$3"; put tab menu
    echo "hide-input+rebind($keys)+enable-search+clear-query+reload-sync($self _show menu)+pos(2)+change-prompt(menu> )+$(label)"
}
menu_items() {  # "label<TAB>action" lines; the first line is the title (no action)
    local from u
    from=$(st mfrom) u=$(st murl)
    printf '\e[1m  %s\e[0m\t\n' "$(st mrow)"
    item() { printf '  %-24s %s\t%s\n' "$1" "$2" "$3"; }
    if [[ $from == queue ]]; then
        item "Jump to this song" enter play; item "Play next" "" next; item "Remove from queue" dd remove
    elif is_list "$u"; then
        item "Open" l open; item "Play all" "" all; item "Play next" "" next; item "Add to queue" a add
    else
        item "Play from here" enter play; item "Play next" "" next; item "Add to queue" a add
    fi
}
menu_back() {  # back to the list the menu came from, on the same row
    local from search=enable-search prompt
    from=$(st mfrom) prompt=$from
    put tab "$from"
    [[ $from == search ]] && search=disable-search
    [[ $from == pl ]] && prompt=list
    echo "$search+hide-input+rebind($keys)+reload-sync($self _show $from)+pos($(($(st mn) + 1)))+change-prompt($prompt> )+$(label)"
}
menu_do() {  # $1 = action
    local u n t
    u=$(st murl) n=$(st mn) t=$(st mrow)
    case $1 in
        play) put tab "$(st mfrom)"; "$self" _enter "$u" "$n" "" "$t" >/dev/null; menu_back ;;  # same as enter on the row
        open) put tab "$(st mfrom)"; open_list "$t" "$u" ;;
        all)
            { busy "Starting \"${t%% ‒ *}\"…"; player && songs "$u" | swap | ctl queue --data-binary @-; } </dev/null &>/dev/null &
            menu_back ;;
        next | add) queue_add "$t" "$u" "$1"; menu_back ;;
        remove) remove_from_queue "$n" "$t"; menu_back ;;
    esac
}

usage() {
    cat <<EOF
$app – YouTube Music on Chromecast speakers (unofficial)

Usage: ytcast [command]

  (none)           open the UI
  play URL|QUERY   play a song or playlist URL, or the first search result
  pause            pause / resume
  next | prev      next / previous track
  stop             stop playback
  vol [N|+N|-N]    show or set volume
  status           show what is playing
  scan             list Cast speakers on the local network
  use IP           switch to the speaker at IP and save it

Config: $config (host=, cookies=)
EOF
}

case "${1:-}" in
    help | -h | --help) usage; exit ;;
    scan) scan | sort -t. -k4,4n; exit ;;
    use)
        [[ -n ${2:-} ]] || { echo "Usage: ytcast use <IP>" >&2; exit 1; }
        s=$(info "$2") || { echo "ytcast: no Cast speaker answers at $2" >&2; exit 1; }
        YTCAST_HOST=$2; save_config
        echo "Using $(name "$s") at $YTCAST_HOST (saved in $config)"; exit ;;
esac
[[ -n $YTCAST_HOST ]] || { echo "ytcast: no speaker chosen. Find one with 'ytcast scan' and pick it with 'ytcast use <IP>'" >&2; exit 1; }

case "${1:-}" in
    play)
        [[ -n ${2:-} ]] || { echo "Usage: ytcast play URL|QUERY" >&2; exit 1; }
        shift
        echo "Asking YouTube Music…" >&2
        case $1 in
            http*list=*) urls=$(songs "$1" | cut -f2) ;;
            http*) urls=$1 ;;
            *) urls=$(songs "$(search_url "$*")#songs" 1 | cut -f2) ;;
        esac
        [[ -n $urls ]] || { echo "ytcast: nothing found" >&2; exit 1; }
        player; ctl queue --data-binary @- <<<"$urls" >&2; exit ;;
    pause | next | prev | stop) player; ctl "$1" >/dev/null; exit ;;
    vol)
        player
        case ${2:-} in
            "") ctl vol; echo ;;
            [+-]*) ctl "vol?delta=${2#+}" >/dev/null ;;
            *) ctl "vol?set=$2" >/dev/null ;;
        esac
        exit ;;
    status) player; ctl now; echo; exit ;;
    # Internal sub-calls from fzf
    _now) ctl now; exit ;;
    _label) label; exit ;;
    _esc) if [[ $(st tab) == menu ]]; then menu_back; else echo "hide-input+rebind($keys)"; fi; exit ;;
    _section)  # tab on the Search tab: songs → videos → albums for the same search
        [[ $(st tab) == search ]] || exit 0
        case $(section) in songs) put section videos ;; videos) put section albums ;; *) put section songs ;; esac
        echo "reload($self _show search)+first+$(label)"
        exit ;;
    _show)  # $2 = list; fetched the first time, then printed with ▶ on the song playing
        f=$(list "$2")
        [[ $2 == menu ]] && { menu_items; exit; }
        [[ $2 == queue ]] && rm -f "$f"  # always fresh from the player
        if [[ ! -e $f ]]; then
            mkdir -p "${f%/*}"
            [[ $2 == search && -z $(st searched) ]] || { msg=$(what "$2"); [[ -z $msg ]] || busy "$msg"; }
            fetch "$2" >"$f.tmp" 2>"$YT_DIR/err" || true
            mv "$f.tmp" "$f"
        fi
        if [[ ! -s $f ]]; then
            if [[ $2 == search && -z $(st searched) ]]; then printf '  Type a search and press enter\t\n'
            elif [[ $2 == queue ]]; then printf '  The queue is empty. Press a on a song to add it\t\n'
            elif [[ -s $YT_DIR/err ]]; then printf '  ! %s\t\n' "$(tail -1 "$YT_DIR/err")"; rm -f "$f"
            else printf '  (empty)\t\n'; fi
            exit 0
        fi
        case $2 in
            playlists) cat "$f" ;;
            queue) awk -F'\t' -v pend="$(st pending)" '
                $3 == pend      { printf "\033[33m⋯ %s -- Fetching…\033[0m\t%s\n", $2, $3; next }
                $1 == "played"  { printf "\033[90m  %s\033[0m\t%s\n", $2, $3; next }  # grey
                $1 == "playing" { printf "\033[1;32m▶ %s\033[0m\t%s\n", $2, $3; next }
                                { printf "  %s\t%s\n", $2, $3 }' "$f" ;;
            speakers) while read -r ip n; do
                    if [[ $ip == "$YTCAST_HOST" ]]; then printf '\e[1;32m▶ %s ‒ %s\e[0m\t%s\n' "$n" "$ip" "$ip"; else printf '  %s ‒ %s\t%s\n' "$n" "$ip" "$ip"; fi
                done <"$f" ;;
            *) awk -F'\t' -v cur="$(ctl current 2>/dev/null || true)" -v pend="$(st pending)" '
                $2 == pend { printf "\033[33m⋯ %s -- Fetching…\033[0m\t%s\n", $1, $2; next }  # enter pressed, stream on its way
                $2 == cur  { printf "\033[1;32m▶ %s\033[0m\t%s\n", $1, $2; next }
                           { printf "  %s\t%s\n", $1, $2 }' "$f" ;;
        esac
        exit ;;
    _enter)  # $2 = {2}: URL or IP; $3 = {n}; $4 = {q}; $5 = {1}
        tab=$(st tab)
        if [[ $tab == search && -n ${4:-} && $4 != "$(st searched)" ]]; then  # a new search
            put searched "$4"; rm -f "$YT_DIR"/search-*
            echo "reload($self _show search)+hide-input+rebind($keys)+first+$(label)"
            exit
        fi
        [[ -n ${2:-} ]] || exit 0
        [[ $tab == menu ]] && { menu_do "$2" | tr -d '\n'; exit; }
        case $tab in
            playlists | search) is_list "$2" && { open_list "$(awk -F'\t' -v u="$2" '$2 == u { print $1; exit }' "$(list "$tab")")" "$2"; exit; } ;;&
            speakers)
                put host "$2"; YTCAST_HOST=$2; save_config
                put name "$(name "$(info "$2")")"
                busy "Connecting to $(st name)…"
                player 2>/dev/null || true
                rm -f "$YT_DIR/busy.$BASHPID"
                view speakers ;;
            liked | pl | search | queue)  # play the list from this song (queue: jump to it); in the background
                t=$(clean "${5:-}")
                put pending "$2"  # "⋯ Title -- Fetching…" on the row until the song plays (or fails)
                {
                    busy "Starting \"${t%% ‒ *}\"…"
                    if [[ $tab == queue ]]; then ctl "jump?i=$3"
                    else player && swap <"$(list "$tab")" | ctl "queue?start=$3" --data-binary @-; fi
                    rm -f "$YT_DIR/pending"
                } </dev/null &>/dev/null &
                echo "track-current+reload($self _show $tab)+transform-footer($self _now)" ;;
        esac
        exit ;;
    _key)  # $2 = key, $3-$5 = {1} {2} {n}. g and d wait 1 s for the next key (gg, gt, gl, …, dd, dG).
        tab=$(st tab) ms=${EPOCHREALTIME/[.,]/} ms=${ms%???}
        read -r pre at <<<"$(st pre)" || true
        (( ms - ${at:-0} < 1000 )) || pre=""
        put pre ""
        if [[ $tab == menu ]]; then  # only moving, h (back) and q work in the menu
            case "${pre:-}$2" in g) put pre "$2 $ms" ;; gg) echo first ;; G) echo last ;; q) echo abort ;; h) menu_back ;; esac
            exit 0
        fi
        case "${pre:-}$2" in
            m) open_menu "$3" "$4" "$5" ;;
            g | d) put pre "$2 $ms" ;;
            gg) echo first ;;
            gl) view liked ;;  # gl, gp, gs, gq, gS: straight to a tab
            gp) view playlists ;;
            gs) view search ;;
            gq) view queue ;;
            gS) view speakers ;;
            gt) tab_step 1 ;;
            gT) tab_step -1 ;;
            G) echo last ;;
            q) echo abort ;;
            p) "$self" prev &>/dev/null & ;;  # in the background: fetching the stream must not freeze the UI
            l) [[ -n $4 ]] && is_list "$4" && open_list "$3" "$4" ;;
            h) [[ $tab == pl ]] && view "$(st plfrom)" ;;
            a) [[ -n $4 && $tab != @(speakers|queue) ]] && queue_add "$3" "$4" ;;
            r) rm -f "$(list "$tab")"; echo "reload($self _show $tab)+$(label)" ;;
            dd) [[ $tab == queue && -n $4 ]] && remove_from_queue "$5" "$3" ;;
            dG) [[ $tab == queue ]] && { ctl clear >/dev/null; note "Cleared the queue after the song playing"; echo "reload($self _show queue)"; } ;;
        esac
        exit 0 ;;
    _ticker)  # status line every 0.12 s (spinner); "now playing" every ~1 s, and the ▶ in the list when the track changes
        last="" shown="" np="" i=0
        while sleep 0.12; do
            act=""
            if (( i % 8 == 0 )); then
                read -r YTCAST_HOST <"$YT_DIR/host" || true
                if np=$(ctl now); then
                    cur="$(ctl current)|$(st pending)" || true  # the song playing, and the one being fetched
                    act="change-footer:$np"
                    tab=$(st tab)
                    if [[ $cur != "$last" && $tab != @(playlists|speakers|menu) && ! ($tab == search && $(section) == albums) ]]; then
                        act="track-current+reload($self _show $tab)+$act"
                    fi
                    last=$cur
                fi
            fi
            [[ -z $act ]] || fzf_do "$act"
            msg=$(status_line "$i" "$np")  # its own request: a "change-…:text" action must come last
            i=$((i + 1))
            [[ $msg == "$shown" ]] || { fzf_do "change-footer-label:$msg"; shown=$msg; }
        done ;;
    "") ;;
    *) usage >&2; exit 1 ;;
esac

export YT_DIR="$run/ytcast-ui-$$"
mkdir -p "$YT_DIR"
trap 'rm -rf "$YT_DIR"' EXIT
player
put host "$YTCAST_HOST"; put name "$(name "$(info "$YTCAST_HOST")")"; put tab liked
"$self" _ticker &
trap 'kill $! 2>/dev/null; rm -rf "$YT_DIR"' EXIT  # the ticker stops with the UI; ytcast-player keeps playing

help='j/k  ctrl-d/u  gg/G   move · half page · top/bottom
gt/gT                 tabs: liked → playlists → search → queue → speakers
gl gp gs gq gS        go to: liked · playlists · search · queue · speakers
tab                   search: songs → videos → albums
l/h                   open playlist / album · back
/  esc                filter (search tab: new search) · back
enter                 play from song · open playlist / album · search · jump in queue · choose speaker
a                     add song / playlist / album to the queue
m                     menu for the row: play · play next · add to queue · open · remove
dd  dG                queue tab: remove the song · everything after the one playing
space  n/p  +/-       pause · next/previous · volume
r                     refresh list (liked songs and playlists are cached)
?  q                  shortcuts · quit (playback continues)'
key="transform($self _key {k} {1} {2} {n})"
fzf --listen="$YT_DIR/fzf.sock" --no-input --no-preview --ansi --delimiter='\t' --with-nth=1 --id-nth=2 --prompt 'liked> ' \
    --layout=reverse --border --border-label " $app │ $(st name) │ $(tabline liked) " \
    --header "$help" --footer ' ' --footer-border=top --footer-label ' Press ? for shortcuts ' \
    --bind "start:reload($self _show liked)+toggle-header,?:toggle-header" \
    --bind "load:transform($self _label)" \
    --bind 'j:down,k:up,ctrl-d:half-page-down,ctrl-u:half-page-up' \
    --bind "g:${key//\{k\}/g},t:${key//\{k\}/t},T:${key//\{k\}/T},h:${key//\{k\}/h},l:${key//\{k\}/l},r:${key//\{k\}/r},a:${key//\{k\}/a}" \
    --bind "s:${key//\{k\}/s},S:${key//\{k\}/S},p:${key//\{k\}/p},d:${key//\{k\}/d},G:${key//\{k\}/G},q:${key//\{k\}/q},m:${key//\{k\}/m}" \
    --bind "tab:transform($self _section)" \
    --bind "enter:transform($self _enter {2} {n} {q} {1})" \
    --bind "space:execute-silent($self pause)+transform-footer($self _now)" \
    --bind "n:execute-silent($self next &>/dev/null &)" \
    --bind "+:execute-silent($self vol +5)+transform-footer($self _now)" \
    --bind "-:execute-silent($self vol -5)+transform-footer($self _now)" \
    --bind "/:show-input+unbind($keys)" \
    --bind "esc:transform($self _esc)" </dev/null
