#!/usr/bin/env python3
"""ytcast-player – player daemon for ytcast. Unofficial; not affiliated with Google or YouTube.

Keeps the Cast connection open and plays a queue of YouTube (Music) URLs track by track. yt-dlp (as a library, kept
warm, with the login read once) turns each URL into an audio stream right before it plays (stream URLs expire); the
next track is resolved in the background meanwhile.
Control API: HTTP over a unix socket (curl --unix-socket):
  GET  /ping /now /current /pause /next /prev /stop /vol[?set=N | ?delta=N]
  GET  /queue           the queue as "played|playing|queued<TAB>title<TAB>URL" lines
  GET  /jump?i=N  /remove?i=N  /clear   play song N · remove song N · remove everything after the one playing
  POST /queue?start=N   body: "URL[<TAB>title]" lines; replaces the queue and plays from song N
  POST /queue?append=1  adds to the end of the queue; plays them if nothing of ours is playing
  POST /queue?next=1    the same, but right after the song playing ("play next")
Quits after 30 min without playback. Usage: ytcast-player <speaker IP> <socket> [browser to read the login from]
"""
import os
import socketserver
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler
from urllib.parse import parse_qs, urlsplit

import pychromecast
import yt_dlp

host, sock = sys.argv[1:3]
cookies = sys.argv[3] if len(sys.argv) > 3 else ""
IDLE_EXIT = 30 * 60
BUILD = str(int(os.path.getmtime(__file__)))  # /ping answers this, so ytcast can restart a daemon left from before an update

cast = pychromecast.get_chromecast_from_host((host, 8009, None, None, None))
cast.wait()
mc = cast.media_controller
lock = threading.Lock()       # one play() at a time
queue, pos = [], -1
playing = ""                  # stream URL we started, to tell our playback from e.g. Spotify
loading = False               # resolving a track (shown in "now playing")
error = ""                    # last track that could not be played
streams = {}                  # prefetched: YouTube URL -> (stream URL, content type, metadata)
titles = {}                   # YouTube URL -> title, from the UI or from yt-dlp, for the queue view
advance = threading.Event()   # set by the status listener; the main loop plays the next track


def print_nothing(*args):  # yt-dlp would print its own ERROR lines; we log one "skipped" line instead
    pass


class Resolver:  # a warm yt-dlp: no start-up per song, and the browser login is read once
    def __init__(self):
        silent = type("Silent", (), {"debug": print_nothing, "warning": print_nothing, "error": print_nothing})()
        opts = {"quiet": True, "no_warnings": True, "noplaylist": True, "format": "ba[ext=m4a]/ba", "logger": silent}
        if cookies:
            opts["cookiesfrombrowser"] = (cookies,)
        self.ydl, self.lock = yt_dlp.YoutubeDL(opts), threading.Lock()

    def __call__(self, url):  # (stream URL, content type, metadata)
        try:
            with self.lock:
                info = self.ydl.extract_info(url, download=False)
        except yt_dlp.utils.DownloadError as e:
            raise RuntimeError(str(e).splitlines()[0].removeprefix("ERROR: ")) from None
        artist = info.get("artist") or info.get("channel") or info.get("uploader") or ""
        # No cover image: a speaker without a screen (Citation Amp) fails the whole load on a webp thumbnail
        meta = {"metadataType": 3, "title": info.get("title") or "", "artist": artist.removesuffix(" - Topic"),
                "albumName": info.get("album") or ""}
        return info["url"], f"audio/{'mp4' if info['ext'] == 'm4a' else info['ext']}", meta


# Two of them, so the song you choose never waits for the prefetch of the next one
resolve, resolve_ahead = Resolver(), Resolver()


def log(event, url, text=""):  # one line per track in the log, e.g. to count how many YouTube refuses
    print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {event:<8} {url}  {text}", file=sys.stderr, flush=True)


log("started", host, f"cookies={cookies or '(none)'}")


def prefetch(i):
    if 0 <= i < len(queue) and queue[i] not in streams:
        try:
            streams[queue[i]] = resolve_ahead(queue[i])
        except RuntimeError:
            pass  # play() tries again and reports it


def play(i):  # play queue[i]; tracks that can't be played (removed, region-locked) are skipped. True if one started.
    global pos, playing, loading, error
    with lock:
        q, loading = queue, True
        try:
            while 0 <= i < len(q):
                try:
                    stream, mime, meta = streams.pop(q[i], None) or resolve(q[i])
                except RuntimeError as e:
                    error = f"skipped: {e}"
                    log("skipped", q[i], str(e))
                    i += 1
                    continue
                if q is not queue:  # a new queue came while we resolved
                    return False
                pos, playing, error = i, stream, ""
                titles.setdefault(q[i], " ‒ ".join(x for x in (meta["title"], meta["artist"]) if x))
                log("played", q[i], meta["title"])
                mc.play_media(stream, mime, metadata=meta)
                threading.Thread(target=prefetch, args=(i + 1,), daemon=True).start()
                return True
            return False
        finally:
            loading = False


def ours():  # is the speaker playing from our queue?
    return bool(playing) and mc.status.content_id == playing


class Listener:
    def new_media_status(self, st):
        global error
        if st.player_state == "IDLE" and st.idle_reason in ("FINISHED", "ERROR") and st.content_id == playing:
            if st.idle_reason == "ERROR":
                error = f"the speaker could not play {st.title}"
                log("refused", queue[pos] if 0 <= pos < len(queue) else "", st.title or "")
            advance.set()

    def load_media_failed(self, item, code):
        log("failed", queue[pos] if 0 <= pos < len(queue) else "", f"load failed: {code}")


mc.register_status_listener(Listener())


def mmss(s):
    return f"{int(s) // 60}:{int(s) % 60:02d}"


def now():  # "now playing" for the footer
    st, cs = mc.status, cast.status
    icon = {"PLAYING": "▶", "BUFFERING": "▶", "PAUSED": "⏸"}.get(st.player_state, "■")
    app = cs.display_name if cs and cs.display_name != "Default Media Receiver" else ""
    out = [f"⋯ Loading {pos + 2 if queue and pos >= 0 else 1}/{len(queue)}…" if loading else f"{icon} {st.title or app or ''}",
           "  " + " – ".join(x for x in (st.artist, st.album_name) if x)]
    if st.duration:
        t = st.adjusted_current_time or 0
        n = int(30 * t / st.duration)
        out.append(f"  {mmss(t)} {'━' * n}{'─' * (30 - n)} {mmss(st.duration)}")
    v = round((cs.volume_level if cs else 0) * 100)
    bar = "".join(c if v >= i * 10 - 5 else "·" for i, c in enumerate("▁▂▃▃▄▅▅▆▇█", 1))
    out.append(f"  {'mute' if cs and cs.volume_muted else 'vol'} {bar} {v}" + (f"   {len(queue) - pos - 1} queued" if ours() else ""))
    if error:
        out.append(f"  ! {error}"[:100])
    return "\n".join(out)


def volume(q):
    v = round(cast.status.volume_level * 100)
    if "set" in q:
        v = int(q["set"])
    elif "delta" in q:
        v += int(q["delta"])
    v = max(0, min(100, v))
    if q:
        cast.set_volume(v / 100)
    return str(v)


def toggle():
    mc.pause() if mc.status.player_state == "PLAYING" else mc.play()


def stop():
    global queue, pos, playing
    if ours():  # never stop someone else's playback
        mc.stop()
    queue, pos, playing = [], -1, ""


def queue_view():
    return "".join(f"{'played' if i < pos else 'playing' if i == pos else 'queued'}\t{titles.get(u) or u}\t{u}\n"
                   for i, u in enumerate(queue))


def remove(i):
    global pos
    if not 0 <= i < len(queue):
        return
    del queue[i]
    if i < pos:
        pos -= 1
    elif i == pos:  # the one playing: go on with the next (now at the same index)
        play(pos) if pos < len(queue) else stop()


commands = {
    "queue": lambda q: queue_view(),
    "jump": lambda q: play(int(q["i"])) and "",
    "remove": lambda q: remove(int(q["i"])),
    "clear": lambda q: queue.__delitem__(slice(pos + 1, None)),
    "ping": lambda q: BUILD,
    "now": lambda q: now(),
    "current": lambda q: queue[pos] if 0 <= pos < len(queue) and ours() else "",
    "vol": volume,
    "pause": lambda q: toggle(),
    "next": lambda q: "" if pos + 1 >= len(queue) else play(pos + 1) and "",
    "prev": lambda q: "" if not queue else play(max(pos - 1, 0)) and "",
    "stop": lambda q: stop(),
}


# --- Control server on the unix socket ---

class Ctl(BaseHTTPRequestHandler):
    def reply(self, code, text):
        b = (text or "").encode()
        self.send_response(code)
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        u = urlsplit(self.path)
        cmd = commands.get(u.path.strip("/"))
        if not cmd:
            return self.reply(404, "unknown command\n")
        self.reply(200, cmd({k: v[0] for k, v in parse_qs(u.query).items()}))

    def do_POST(self):  # /queue
        global queue, error
        qs = parse_qs(urlsplit(self.path).query)
        items = []
        for line in self.rfile.read(int(self.headers.get("Content-Length", 0))).decode().splitlines():
            url, _, title = line.partition("\t")
            if url:
                items.append(url)
                if title:
                    titles[url] = title
        if not items:
            return self.reply(400, "empty queue\n")
        if "append" in qs or "next" in qs:
            start = pos + 1 if "next" in qs and 0 <= pos < len(queue) else len(queue)
            queue[start:start] = items  # in place, so a play() that is resolving keeps going
            if loading or (ours() and mc.status.player_state in ("PLAYING", "BUFFERING", "PAUSED")):
                threading.Thread(target=prefetch, args=(pos + 1,), daemon=True).start()
                return self.reply(200, "")
        else:
            queue, error = items, ""
            start = min(int(qs.get("start", ["0"])[0]), len(items) - 1)
        if play(start):
            return self.reply(200, "")
        self.reply(500, f"{error or 'nothing could be played'}\n")

    def address_string(self):
        return "ytcast"

    def log_message(self, *a):
        pass


class CtlServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


if os.path.exists(sock):
    os.unlink(sock)
ctl = CtlServer(sock, Ctl)
threading.Thread(target=ctl.serve_forever, daemon=True).start()

try:
    active = time.monotonic()
    while True:
        if advance.wait(1):
            advance.clear()
            play(pos + 1)
        if mc.status.player_state in ("PLAYING", "BUFFERING") or loading:
            active = time.monotonic()
        elif time.monotonic() - active > IDLE_EXIT:
            break
finally:
    os.unlink(sock)
    cast.disconnect()
